# 后端网关地址（仅服务端使用，Nitro 会以 /api/** 转发，浏览器无需跨域）
# NUXT_API_BASE=http://127.0.0.1:8080/prod-api

# 后端上传文件域名（浏览器可访问），不填时默认取 NUXT_API_BASE 的协议+域名，
# 例如网关 http://127.0.0.1:8080/prod-api 会自动用 http://127.0.0.1:8080 拼接 /profile/upload/...
# NUXT_PUBLIC_FILE_BASE=http://127.0.0.1:8080

# 是否使用内置 mock 数据：true 开（默认），false 关
NUXT_MOCK=true

# 关闭 Nuxt 遥测
NUXT_TELEMETRY_DISABLED=true
